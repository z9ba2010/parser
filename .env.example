# ========================================================
# Sport, Supplements & Events Hub - Environment Variables
# ========================================================

# Project metadata
PROJECT_NAME="Sport, Supplements & Events Hub API"
VERSION="1.0.0"

# Database Configuration:
# - Local SQLite (default for standalone development):
DATABASE_URL="sqlite:///./sporthub.db"
# - Production PostgreSQL + PostGIS (Docker / Cloud):
# DATABASE_URL="postgresql+psycopg2://postgres:sporthub_pass@db:5432/sporthub"

# AI / Vision Configuration:
# Obtain your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
ENABLE_MOCK_VISION_FALLBACK="true"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
